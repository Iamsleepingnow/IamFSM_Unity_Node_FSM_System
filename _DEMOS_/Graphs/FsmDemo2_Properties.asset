    title: "\u903B\u8F91\u5165\u53E3"
    content: "\u5F53\u5F00\u59CB\u8FD0\u884C\u65F6\uFF0C\u5C06Count\u91CD\u7F6E\u4E3A0\uFF0C\u7136\u540E\u8FDB\u5165Idle\u72B6\u6001\u3002"
  - position:
      serializedVersion: 2
      x: 60.666668
      y: 427.33334
      width: 267.33334
      height: 136.66666
    title: "\u8FDB\u5165Idle\u72B6\u6001"
    content: "\u5F53\u8FDB\u5165Idle\u72B6\u6001\u65F6\uFF0C\u9700\u8981\u540C\u65F6\u5BF9\u4E0A\u4E0B\u4E24\u4E2A`\u6761\u4EF6\u6EE1\u8DB3`\u8282\u70B9\u8FDB\u884C\u5224\u65AD\uFF1A\n1.
      \u5F53\u6309\u4E0B\u9F20\u6807\u5DE6\u952E\u4E14Count\u5C0F\u4E8EGate\u3002\n2.
      \u5F53Count\u5927\u4E8E\u7B49\u4E8EGate\u3002\n\u5F53\u5176\u4E2D\u4E00\u4E2A`\u6761\u4EF6\u6EE1\u8DB3`\u8282\u70B9\u901A\u8FC7\u65F6\uFF0C\u5176\u4F59\u7684`\u6761\u4EF6\u6EE1\u8DB3`\u8282\u70B9\u90FD\u4E0D\u518D\u8FDB\u884C\u5224\u65AD\u3002"
  - position:
      serializedVersion: 2
      x: 849.99994
      y: 282.66666
      width: 267.3333
      height: 102.66669
    title: "\u6761\u4EF6\u6EE1\u8DB3"
    content: "\u5F53\u6B64\u6761\u4EF6\u6EE1\u8DB3\u65F6\uFF0C\u89E6\u53D1Click\u4E8B\u4EF6\uFF0C\u8F93\u51FA\u65E5\u5FD7\uFF0CCount\u6570\u503C\u7D2F\u52A0\uFF0C\u91CD\u65B0\u8FDB\u5165Idle\u72B6\u6001\u3002"
  - position:
      serializedVersion: 2
      x: 744.18146
      y: 1187.6584
      width: 267.33337
      height: 102.666626
    title: "\u6761\u4EF6\u6EE1\u8DB3"
    content: "\u5F53\u6B64\u6761\u4EF6\u6EE1\u8DB3\u65F6\uFF0C\u89E6\u53D1Reload\u4E8B\u4EF6\uFF0C\u5C06Count\u91CD\u7F6E\u4E3A0\uFF0C\u5E76\u8FDB\u5165`\u7B49\u5F85\u79D2\u6570`\u8282\u70B9\u3002"
  - position:
      serializedVersion: 2
      x: 1843.16
      y: 1026.8385
      width: 267.33337
      height: 102.66675
    title: "\u5EF6\u65F6\u7B49\u5F85"
    content: "\u5F53\u7B49\u5F85\u8FDB\u884C\u4E2D\u65F6\uFF0C\u6BCF\u5E27\u89E6\u53D1`Delay
      Update`\u7EBF\uFF0C\u5C06ReloadProgress\u8BBE\u7F6E\u4E3A\u7B49\u5F85\u8FDB\u5EA6\uFF080~1\uFF09\u3002\n\u5F53\u7B49\u5F85\u5B8C\u6210\u65F6\uFF0C\u5C06ReloadProgress\u91CD\u7F6E\u4E3A0\u3002"
  - position:
      serializedVersion: 2
      x: 57.536175
      y: -571.6522
      width: 267.33334
      height: 104.66666
    title: "\u53C2\u6570\u9762\u677F"
    content: "\u5728\u6B64\u7A97\u53E3\u7684\u5DE6\u4E0A\u89D2\u6709\u4E00\u4E2A`\u663E\u793A\u53C2\u6570`\u6309\u94AE\uFF0C\u70B9\u51FB\u5E76\u67E5\u770B\u8282\u70B9\u56FE\u7684\u53C2\u6570\u3002"
