      y: 1898.4348
      width: 222
      height: 100
    title: "\u6BD4\u8F83\u6761\u4EF6\u8282\u70B9"
    content: "`\u7B49\u4E8E`\u8282\u70B9\u53EF\u4EE5\u5BF9\u4E24\u4E2A\u4EFB\u610F\u503C\u8FDB\u884C\u6BD4\u8F83\u3002`\u6570\u5B57\u6BD4\u8F83`\u8282\u70B9\u53EF\u4EE5\u5BF9\u4E24\u4E2A\u6570\u5B57\u8FDB\u884C\u6BD4\u8F83\u3002"
  - position:
      serializedVersion: 2
      x: 417.33334
      y: 2179.3333
      width: 221.99997
      height: 116.66675
    title: "\u8F93\u5165\u76D1\u542C\u6761\u4EF6\u8282\u70B9"
    content: "\u7528\u4E8E\u5BF9\u786C\u4EF6\u8F93\u5165\u8FDB\u884C\u76D1\u542C\u5224\u65AD\u3002\u5F53\u5F53\u524D\u5E27\u89E6\u53D1\u65F6\uFF0C\u8F93\u51FA\u7AEF\u53E3\u4F1A\u8FD4\u56DE\u771F\u3002\n`\u8F93\u5165\u76D1\u542C`\u8282\u70B9\u4E13\u95E8\u7528\u4E8E\u517C\u5BB9Unity\u7684InputSystem\u6A21\u5757\u3002\n\u4E00\u822C\u642D\u914D`\u6761\u4EF6\u6EE1\u8DB3`\u8282\u70B9\u4F7F\u7528"
  - position:
      serializedVersion: 2
      x: 418
      y: 2472
      width: 222
      height: 286
    title: "\u7269\u7406\u68C0\u6D4B\u8282\u70B9"
    content: "\u7269\u7406\u68C0\u6D4B\u8282\u70B9\u4E3B\u8981\u5206\u4E3A\u4E24\u7C7B\uFF1A\u78B0\u649E\u68C0\u6D4B\u4E0E\u5C04\u7EBF\u68C0\u6D4B\u3002\n\n\u78B0\u649E\u68C0\u6D4B\uFF1A\n\u78B0\u649E\u548C\u89E6\u53D1\u8282\u70B9\u90FD\u6709`\u8FDC\u7A0B`\u53D8\u4F53\uFF0C\u9700\u8981\u642D\u914DFsmCollisionProxy\u7EC4\u4EF6\u4F7F\u7528\u3002\u8FDC\u7A0B\u8282\u70B9\u4F1A\u68C0\u6D4B\u6240\u6709\u6DFB\u52A0\u4E86\u8BE5\u7EC4\u4EF6\u7684\u78B0\u649E\u7BB1\u3002\u975E\u8FDC\u7A0B\u7684\u7248\u672C\u7684\u78B0\u649E\u7BB1\u9ED8\u8BA4\u4E3AFsm\u64AD\u653E\u5668\u7EC4\u4EF6\u6240\u5728\u7269\u4F53\u7684\u78B0\u649E\u7BB1\u3002\n\u5F53\u4F11\u7720\u9608\u503C\u4E3A0\u65F6\uFF0C\u78B0\u649E\u7BB1\u4E0D\u4F1A\u4F11\u7720\u3002\n\n\u5C04\u7EBF\u68C0\u6D4B\uFF1A\n\u91CD\u53E0\u68C0\u6D4B\u4E0E\u78B0\u649E\u68C0\u6D4B\u7C7B\u4F3C\uFF0C\u4F46\u662F\u662F\u6BCF\u5E27Update\u8C03\u7528\u7684\uFF0C\u6027\u80FD\u4E0D\u5982\u78B0\u649E\u68C0\u6D4B\uFF0C\u6240\u4EE5\u8BBE\u7F6E\u4E86Refresh
      Rate\u5237\u65B0\u7387\u6765\u9650\u5236\u66F4\u65B0\u901F\u7387\u3002"
