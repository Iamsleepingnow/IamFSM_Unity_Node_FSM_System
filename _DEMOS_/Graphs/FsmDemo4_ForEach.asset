      width: 267.3333
      height: 166
    title: "\u5FAA\u73AF"
    content: "\u5F53\u8FDB\u5165\u5FAA\u73AF\u72B6\u6001\u65F6\uFF0C\u5206\u522B\u8981\u8FDB\u884C\u4E24\u6761\u6267\u884C\u901A\u8DEF\u7684\u5224\u65AD\uFF0C\u8FD9\u91CC\u4F7F\u7528\u4E86`\u5206\u652F\u6392\u5E8F`\u6765\u8BBE\u7F6E\u6267\u884C\u987A\u5E8F\u3002\n\n\u5F53Interation\u5C0F\u4E8EMaxCount\u65F6\uFF0CInteration\u9012\u589E\uFF0C\u89E6\u53D1ForEachTick\u4E8B\u4EF6\uFF0C\u91CD\u65B0\u8FDB\u5165\u5FAA\u73AF\u72B6\u6001\u3002\n\n\u5F53Interation\u5927\u4E8E\u7B49\u4E8EMaxCount\u65F6\uFF0CInteration\u5F52\u96F6\uFF0C\u89E6\u53D1Completed\u4E8B\u4EF6\uFF0C\u8FD4\u56DEIdle\u72B6\u6001\u3002"
  - position:
      serializedVersion: 2
      x: 268.00003
      y: 1308.5002
      width: 267.3333
      height: 104.66675
    title: "\u53C2\u6570\u9ED8\u8BA4\u503C"
    content: "\u5F53\u5728Project\u7A97\u53E3\u4E2D\u9009\u4E2D\u8282\u70B9\u8868\u6587\u4EF6\u65F6\uFF0C\u53EF\u4EE5\u5728Inspector\u9762\u677F\u4E0A\u8BBE\u7F6E\u66B4\u9732\u53C2\u6570\u7684\u9ED8\u8BA4\u503C\u3002\n\u4F8B\u5982MaxCount\u7684\u9ED8\u8BA4\u503C\u4E3A10\u3002"
